# Logger
LOG_LEVEL= # options = [error, warn, info, http, verbose, debug, silly]
LOG_FORMAT= # json (default) or prettyPrint

# Required for hashing user IDs used in cloud storage object keys
USER_ID_SALT=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

LOCAL_KB_API_KEY=

# NextAuth
NEXTAUTH_SECRET= # to generate, run command `openssl rand -base64 32`
# https required in production
NEXTAUTH_URL=http://localhost:3000
# If left empty, provider button will not be shown on login page
# options = [azure-ad, keycloak, credentials]
ENABLED_NEXTAUTH_PROVIDERS=azure-ad,keycloak
# Set secure attribute on cookies
ENABLE_SECURE_COOKIES=false
# Designated path that maps to an OAuth Profile object that contains the roles (i.e., 'role' OR 'resource.access.palm.role').
INHERITED_OAUTH_ROLE_PATH=

## AzureAD SSO
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

## KeyCloak SS0
KEYCLOAK_ID=
KEYCLOAK_SECRET=
# https required in production
KEYCLOAK_ISSUER=http://keycloak:8080/realms/<realm-name>

# Database Configuration
# POSTGRES_* only required in development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# DATABASE_URL is used in development and production
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB
# Used for running migrations in production image
MIGRATION_DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB

# Redis configuration for development
REDIS_HOST=redis
REDIS_PORT=6379

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Set to 1 to run the Neo4j integration tests (skipped by default; requires a live Neo4j instance)
RUN_NEO4J_ITESTS=

# Market compensation data source API keys (used by the RCAST agent)
# Bureau of Labor Statistics (BLS) API (https://data.bls.gov/registrationEngine/) (Free: ~25 requests/day, With key: 500 requests/day)
BLS_API_KEY=
# Department of Labor (DOL) API (https://www.careeronestop.org/Developers/WebAPI/registration.aspx) (Provides wage data and career information)
CAREER_ONE_STOP_USER_ID=
CAREER_ONE_STOP_API_KEY=

# Salary.com API Configuration 
SALARY_COM_CLIENT_ID=
SALARY_COM_CLIENT_SECRET=
# Optional: Provide a pre-generated token to avoid token API calls (saves API quota)
SALARY_COM_TOKEN=

# Features to turn on
# FeaturePrefix_ is the feature prefix defined in @/features/shared/utils/is-feature-on.ts

# Defaults to 'Feature_' if left blank
FEATURE_FLAG_PREFIX=Feature_

# example is the feature's name
FeaturePrefix_example=false

Feature_PALM_KB=false

# LangGraph service (LangGraph Python microservice)
# Defaults to http://langgraph-service:8000 when running in Docker
LANGGRAPH_SERVICE_URL=http://langgraph-service:8000

# Claude Agent SDK service (specialist node for coding/computer-use workloads)
# Defaults to http://claude-service:8000 when running in Docker
CLAUDE_SERVICE_URL=http://claude-service:8000

# Docling document parsing service (structure-aware PDF/DOCX/XLSX chunking with OCR)
# Defaults to http://docling-service:8000 when running in Docker
DOCLING_SERVICE_URL=http://docling-service:8000

# Configure a GitHub provider and mark it as "Skill Repository" to enable this feature
# The service URL can be overridden here if needed (defaults to http://repo-service:8002)
SKILL_REPO_SERVICE_URL=http://repo-service:8002

# Shared secret between Next.js and the agent service for internal API calls
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
